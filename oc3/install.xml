<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>DearSoft Typeahead Fix</name>
  <code>dearsoft-typeahead-fix</code>
  <version>3.6.0</version>
  <author>DearSoft</author>
  <link>https://dearsoft.com.bd</link>

  <file path="catalog/view/theme/*/template/common/header.twig">
